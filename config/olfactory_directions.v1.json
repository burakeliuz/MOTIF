{
 "library_version": "olfactory-1.0",
 "status": "active",
 "provenance_category": "design_rule",
 "notice": "MOTIF's MVP library of olfactory directions (accord types) for the scent architecture (docs/OLFACTORY_LAYER.md). A direction is a creative building block for a perfumer, not a formula: no doses, no proportions, no safety or regulatory statement. Its sensory cells are labelled: 'odor_data' cells come from config/candidates/odor_axis_evidence.v1.json (x2 = both rated datasets, x1 = one); 'design' cells are MOTIF's reading. Material references are examples of a class: the generic name and its descriptors come from the IFRA Fragrance Ingredient Glossary (2019) as digitized in the Pyrfume archive; a trade name appears only where MOTIF read the supplier's own page (identity and provenance only, never the sensory authority).",
 "cell_rule": "odor_data x2 -> 0.5, odor_data x1 -> 0.25; D85 LIGHT/HEAVY counts as x1 with the caveat that it partly tracks pleasantness; 'rated less sweet' is never used as data for 'dry' (it is cited only as consistent with a design cell); design -> 0.25, or 0.5 when it is the accord's defining quality. null = no claim.",
 "roles": {
  "opening": "first impression, most volatile",
  "core": "heart, the character",
  "drydown": "base, what stays on skin or fabric"
 },
 "sources": {
  "IFRA19": "IFRA Fragrance Ingredient Glossary (2019), as digitized in the Pyrfume archive (ifra_2019/behavior.csv: the top 3 descriptors of each ingredient, in order); read as data via raw.githubusercontent.com, not the IFRA document itself",
  "OAE": "config/candidates/odor_axis_evidence.v1.json (Dravnieks 1985, Keller & Vosshall 2016)",
  "PALETTE": "config/material_palette.json palette-0.3: supplier pages read for identity (verified_full_page)"
 },
