  "commonness": {
    "rule": "A cue group is 'common' when it matches descriptors (own or related, scope above) for at least common_cue_min_seeds of the reference seeds. Common cues are shown as context and never count toward motif support.",
    "common_cue_min_seeds": 4,
    "reference_set": "stage-2 full run live-20261006T103307Z-660d, seeds a24, muji, cdg, nike, ralph_lauren",
    "common_cue_groups_in_reference_set": [
      "intimate",
      "minimalist",
      "playful",
      "precise"
    ],
    "note": "Frozen per lexicon version so that a single user query is scored against a fixed reference, not against itself."
  },
  "support": {
    "source_kinds": [
      "own",
      "brand",
      "movie",
      "artist"
    ],
    "anchor_sources": [
      "own",
      "brand"
    ],
    "counting": "Support counts distinct source kinds with at least one non-common cue match. Repeats of the same cue or tag ID inside one source kind add no support. Several entities in one domain are one source kind.",
    "strength": {
      "strong": "anchored and >= 3 source kinds",
      "moderate": "anchored and >= 2 source kinds, or own source with >= 2 distinct non-common cue groups",
      "weak": "some non-common evidence but below moderate (for example media domains only)",
      "context_only": "only common cues matched"
    },
    "activation": "A motif is active when its strength is strong or moderate.",
    "independence_note": "Distinct source kinds are not proof of independent evidence; the label is a design parameter.",
    "parameters": {
      "strong_min_source_kinds": 3,
      "moderate_min_source_kinds": 2,
      "own_route_min_cue_groups": 2,
      "anchor_sources": [
        "own",
        "brand"
      ]
    },
    "synonym_note": "Variants inside one cue group are treated as one descriptor. Different cue groups of one motif (for example 'muted' and 'understated') are treated as distinct descriptors; MOTIF has no wider synonym model (known limitation)."
  },
  "changes": [
    {
      "version": "lexicon-0.2",
      "date": "2026-10-06",
      "before_t1": true,
      "changes": [
        "Negation guard: a cue preceded within two tokens by not/no/non/without/anti/never is recorded as negated and never counts as support (owner requirement, stage 4).",
        "Own-only route to 'moderate' counts distinct cue groups instead of distinct tag IDs, so the same cue word in two own tags (for example 'Classic Tailoring' and 'Classic') is not counted twice."
      ],
      "effect_on_stage3_examples": "No sensory target changes for the five reference seeds; Ralph Lauren seed-only 'heritage' (an unmapped motif) drops from moderate to weak."
    }
  ]
