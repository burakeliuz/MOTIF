{
  "lexicon_version": "lexicon-0.2",
  "status": "frozen_for_t1",
  "provenance_category": "design_rule (classification rule, human-authored)",
  "notice": "Authored in stage 3 after reading the five stage-2 seeds; it is therefore tuned on them and must be checked on held-out brands (MOTIF_BUILD_SPEC.md, stage-4 task T1). Cue words are classification rules, not Qloo labels. Weights and thresholds are design parameters, not validated statistics.",
  "match": {
    "normalization": "lowercase; '-' and non-letters become spaces; whole-word phrase match of any variant inside the tag name",
    "namespaces": {
      "own": [
        "urn:tag:aesthetic_property:qloo",
        "urn:tag:personal_style:qloo",
        "urn:tag:emotional_tone:qloo"
      ],
      "brand": [
        "urn:tag:aesthetic_property:qloo",
        "urn:tag:emotional_tone:qloo"
      ],
      "movie": [
        "urn:tag:style:qloo"
      ],
      "artist": [
        "urn:tag:style:qloo"
      ]
    },
    "ignore_tag_names": [
      "null"
    ],
    "exclude_patterns": [
      "\\b(pop|rock|rap|hip hop|soul|folk|r b|jazz|electronic|punk|wave|funk|synth|indie|trap|boom bap|chillwave)\\b",
      "\\bcombat\\b"
    ],
    "exclude_patterns_note": "First pattern: music genre names inside urn:tag:style:qloo (for example 'Baroque Pop' is a genre, not opulence); applied to every source for simplicity. Second: 'close quarter combat' is not closeness.",
    "bare_pole_word_tags_are_not_cues": [
      "warm",
      "cool",
      "light",
      "dense",
      "raw",
      "polished",
      "natural",
      "synthetic",
      "projecting",
      "sweet",
      "dry"
    ],
    "bare_pole_word_note": "A tag whose whole name is a single axis pole word (for example 'Raw', 'Polished', 'Warm') never counts as a cue; axes move only through motif rules R1-R5. 'Intimate' is exempt because it is a motif name; it is a common cue in the reference set anyway. Phrases such as 'Natural Materials' remain cues.",
    "negators": [
      "not",
      "no",
      "non",
      "without",
      "anti",
      "never"
    ],
    "negation_window_tokens": 2
  },
